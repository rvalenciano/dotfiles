# ==============================================================================
# Ghostty — Fast, feature-rich, GPU-accelerated terminal emulator
# Docs: https://ghostty.org/docs/config/reference
# ==============================================================================

# --- Window ---
window-padding-x = 10
window-padding-y = 10
window-decoration = none

# --- Font ---
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# --- Cursor ---
cursor-style = block
cursor-style-blink = false

# --- Scrollback ---
scrollback-limit = 10000

# --- Input ---
macos-option-as-alt = true

# --- Keybindings ---
keybind = super+shift+enter=new_window

# --- Tokyo Night Dark ---
background = #1a1b26
foreground = #c0caf5
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5